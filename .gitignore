# Source folders: raw exports, slices, per-country configs. Never committed.
*_src/

# Chat exports — never commit raw user data (may contain PII)
*.json
# ...except the engine's own config. No exception for examples/: a JSON
# there is most likely a misplaced export, and it must not slip into a commit.
!scripts/*.json
exports/

# Intermediate topic slices (pipeline stage 0)
**/_slices/
_slices/

# Generated country guides (users build their own)
/countries/

# System
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
